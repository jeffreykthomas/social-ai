PORT=3001
CORS_ORIGINS=http://localhost:5173
SOCIAL_PET_GAME_CONFIG_PATH=config/social-pet-game.json

# Model provider: openai | anthropic | heuristic
LLM_PROVIDER=heuristic

# Keep low for message latency. If provider exceeds this budget, fallback path is used.
LLM_TIMEOUT_MS=900

# Number of prior user/assistant turns included for conversation context.
LLM_HISTORY_TURNS=8

# OpenAI (Responses API)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Anthropic (Messages API)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest

# Persistence: memory | redis | postgres | hybrid
PERSISTENCE_MODE=memory
DATABASE_URL=postgres://postgres:postgres@localhost:5432/social_pet
REDIS_URL=redis://localhost:6379

# Max events retained in session log
EVENT_LOG_MAX=200

# Social Pet arena simulator (used by scripts/run_stack.sh in social_pet mode)
ARENA_MODEL_COUNT=9
ARENA_PAIRINGS_PER_MODEL=8
# Keep low by default when running continuously in a local loop.
ARENA_MAX_PAIRS=1
ARENA_DAYS=14
ARENA_TURNS_PER_DAY=6
ARENA_PERSONA_MODE=adversarial
ARENA_PERSONA_ITERATIONS=1
ARENA_TEACHER_LOG_PATH=model/training/arena/teacher.jsonl
ARENA_SUMMARY_PATH=model/training/arena/summary.json

# Persona (generation + retrieval)
# Enable injection of persona prompt summary + optional vector matches into the system prompt.
PERSONA_RAG_ENABLED=false
# Where the generated persona + index are read/written by tooling and the /persona/* endpoints.
PERSONA_DOC_PATH=model/persona.generated.json
PERSONA_INDEX_PATH=model/persona.generated.index.json
PERSONA_RAG_TOP_K=4
PERSONA_RAG_MAX_CHARS=1400

# Transcript (full run log + optional retrieval)
TRANSCRIPT_ENABLED=true
TRANSCRIPT_DIR=model/transcripts
TRANSCRIPT_INDEX_DIR=model/transcripts-index
TRANSCRIPT_RAG_ENABLED=false
TRANSCRIPT_RAG_TOP_K=4
TRANSCRIPT_RAG_MAX_CHARS=1400

# User model (schema-shaped memory about the player)
USER_MODEL_ENABLED=false
# If true, update user model after every interaction (can be expensive).
USER_MODEL_UPDATE_ON_INTERACTION=false
USER_MODEL_DIR=model/users
USER_MODEL_OPENAI_MODEL=gpt-5.2

# Voice: ElevenLabs TTS (comma-separated voice IDs per gender)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_IDS_FEMALE=
ELEVENLABS_VOICE_IDS_MALE=
ELEVENLABS_MODEL_ID=eleven_turbo_v2_5

# ElevenLabs Conversational AI (real-time voice-to-voice)
# Create an agent at https://elevenlabs.io/agents, set Custom LLM URL to
# your backend /v1/chat/completions endpoint, then paste the agent ID here.
ELEVENLABS_AGENT_ID=agent_7901kh21nbxffnebbbqzqpj5q06z

# Voice: OpenAI Whisper STT (uses OPENAI_API_KEY above)
