{
  "name": "@social-pet/api",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "dev": "tsx watch src/app.ts",
    "persona:generate": "node --import tsx src/scripts/persona/generateAdversarial.ts",
    "arena:simulate": "node --import tsx src/scripts/training/runArena.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "start": "node dist/app.js"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.74.0",
    "@fastify/cors": "^11.2.0",
    "@fastify/websocket": "^11.2.0",
    "@social-pet/domain": "*",
    "dotenv": "^17.2.4",
    "fastify": "^5.2.1",
    "ioredis": "^5.9.2",
    "openai": "^6.18.0",
    "pg": "^8.18.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@types/pg": "^8.16.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
