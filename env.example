# Copy this file to `.env` at the repo root and fill in values.
# `.env` is gitignored.

# OpenAI (teacher; used via the OpenAI Responses API)
OPENAI_API_KEY=

# Student (local OpenAI-compatible endpoint, e.g. vLLM)
STUDENT_BASE_URL=http://127.0.0.1:8001/v1
STUDENT_API_KEY=local-dev
STUDENT_MODEL=Qwen/Qwen2.5-32B-Instruct

# Optional: force routing globally ("teacher" or "student")
# MODEL_PROVIDER=teacher


